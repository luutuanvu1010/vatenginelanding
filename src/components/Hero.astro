---
// Hero Section
---

<section class="hero" id="hero" aria-label="Giới thiệu VATEngine">
  <!-- Background decoration -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="container hero-inner">
    <!-- Text content -->
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="badge badge-free">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Kết nối trực tiếp Tổng cục Thuế
        </span>
      </div>

      <h1 class="hero-title reveal">
        Trích xuất hóa đơn điện tử
        <span class="hero-title-accent">Nhanh, Chuẩn, An toàn</span>
      </h1>

      <p class="hero-desc reveal">
        VATEngine kết nối trực tiếp tới Hệ thống Hóa đơn điện tử Tổng cục Thuế,
        tự động trích xuất <strong>đầy đủ dữ liệu</strong> hóa đơn đầu vào/đầu ra,
        đối chiếu thông minh và xuất sang phần mềm kế toán — không qua trung gian.
      </p>

      <div class="hero-actions reveal">
        <a
          href="https://vatengine.tourdao.vn"
          class="btn btn-primary"
          target="_blank"
          rel="noopener"
          id="hero-cta-primary"
        >
          Đăng ký dùng thử
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#how-it-works" class="btn btn-outline" id="hero-cta-secondary">
          Xem cách hoạt động
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="hero-trust reveal">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--success-600)" aria-hidden="true">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="var(--success-600)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Không lưu mật khẩu
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Kết nối trực tiếp GDT
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Mã nguồn minh bạch
        </div>
      </div>
    </div>

    <!-- Hero image / mockup -->
    <div class="hero-visual reveal">
      <div class="hero-mockup-wrapper">
        <div class="hero-mockup-shadow"></div>
        <img
          src="/dashboard-mockup.jpg"
          alt="Giao diện VATEngine — Danh sách hóa đơn điện tử với tính năng lọc, tra cứu và xuất Excel"
          width="720"
          height="480"
          loading="eager"
          decoding="async"
          class="hero-mockup-img"
        />
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="container">
    <div class="hero-stats reveal">
      <div class="stat-item">
        <span class="stat-number">20,000+</span>
        <span class="stat-label">Hóa đơn đã xử lý</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">30+</span>
        <span class="stat-label">Trường dữ liệu</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">99.5%</span>
        <span class="stat-label">Độ chính xác đồng bộ</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">0₫</span>
        <span class="stat-label">Chi phí sử dụng</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero layout */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--sp-20);
    padding-bottom: 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-16);
    }
  }

  /* Background decorations */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.12;
  }
  .hero-blob-1 {
    width: 480px;
    height: 480px;
    background: var(--brand-600);
    top: -120px;
    right: -80px;
  }
  .hero-blob-2 {
    width: 360px;
    height: 360px;
    background: var(--info-600);
    bottom: 40px;
    left: -100px;
    opacity: 0.08;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,0,0,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,.03) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at 60% 40%, black 30%, transparent 75%);
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .hero-badge { display: flex; }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--fw-extrabold);
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .hero-title-accent {
    display: block;
    background: linear-gradient(135deg, var(--brand-600) 0%, #e8453c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: var(--fs-lg);
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 520px;
  }
  .hero-desc strong { color: var(--text-primary); font-weight: var(--fw-semibold); }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }

  /* Trust indicators */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    padding-top: var(--sp-2);
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-tertiary);
    font-weight: var(--fw-medium);
  }

  /* Mockup */
  .hero-visual {
    position: relative;
    z-index: 1;
  }
  .hero-mockup-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .hero-mockup-shadow {
    position: absolute;
    inset: -4px;
    border-radius: calc(var(--radius-xl) + 4px);
    background: linear-gradient(135deg, rgba(197,34,31,.2) 0%, rgba(26,115,232,.15) 100%);
    filter: blur(24px);
    transform: translateY(8px);
    z-index: -1;
  }
  .hero-mockup-img {
    width: 100%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  /* Stats bar */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    margin-top: var(--sp-16);
    padding: var(--sp-6) var(--sp-8);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    box-shadow: var(--shadow-sm);
  }

  .stat-item {
    flex: 1;
    min-width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-3) var(--sp-4);
    text-align: center;
  }
  .stat-number {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-extrabold);
    color: var(--brand-600);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: var(--fs-sm);
    color: var(--text-tertiary);
    font-weight: var(--fw-medium);
  }
  .stat-divider {
    width: 1px;
    background: var(--border-subtle);
    align-self: stretch;
    margin-block: var(--sp-3);
  }

  /* Reveal stagger */
  .hero-content .reveal:nth-child(1) { transition-delay: 0s; }
  .hero-content .reveal:nth-child(2) { transition-delay: 0.1s; }
  .hero-content .reveal:nth-child(3) { transition-delay: 0.2s; }
  .hero-content .reveal:nth-child(4) { transition-delay: 0.3s; }
  .hero-content .reveal:nth-child(5) { transition-delay: 0.4s; }
  .hero-visual { transition-delay: 0.15s; }
</style>
